{
  "name": "reviewbot-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, self-hosted AI code review bot for GitHub pull requests",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --dry",
    "clean": "npm run --workspaces --if-present clean"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
