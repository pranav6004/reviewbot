# ==========================================
# ReviewBot Environment Configuration
# ==========================================

# Server Network Settings
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# SQLite Database Location
DATABASE_PATH=./data/reviewbot.sqlite

# GitHub App Authentication (Required for GitHub App mode)
# Create your GitHub App at https://github.com/settings/apps/new
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# LLM Provider Configuration (BYOK - Bring Your Own Key)
# Supports any OpenAI-compatible endpoint: OpenAI, Ollama, Groq, DeepSeek, OpenRouter
REVIEWBOT_LLM_BASE_URL=https://api.openai.com/v1
REVIEWBOT_LLM_API_KEY=sk-proj-your-api-key-here
REVIEWBOT_LLM_MODEL=gpt-4o-mini

# For local Ollama:
# REVIEWBOT_LLM_BASE_URL=http://host.docker.internal:11434/v1
# REVIEWBOT_LLM_API_KEY=ollama
# REVIEWBOT_LLM_MODEL=llama3.1:8b

# For DeepSeek:
# REVIEWBOT_LLM_BASE_URL=https://api.deepseek.com/v1
# REVIEWBOT_LLM_API_KEY=sk-...
# REVIEWBOT_LLM_MODEL=deepseek-chat
